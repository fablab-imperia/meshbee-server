# =======================================================
# Beehive IoT - Configurazione Server
# =======================================================
# Copia questo file in .env e imposta valori reali e sicuri.
# IMPORTANTE: Non committare mai .env nel repository!
#
# Primo avvio:
#   cp .env.example .env
#   # Modifica .env con password sicure
#   make start
# =======================================================

# --- PostgreSQL ---
# Password del database PostgreSQL
POSTGRES_PASSWORD=imposta_password_sicura_qui

# --- MQTT Broker ---
# Username e password per il broker Mosquitto
MQTT_USER=beehive
MQTT_PASSWORD=imposta_password_sicura_qui

# --- Utenti applicazione ---
# Obbligatorie, minimo 8 caratteri: se mancano o sono troppo corte il servizio
# `seed` termina con errore invece di creare account con password vuota.
# Password per l'utente admin (admin@beehive.local), creato al primo avvio
ADMIN_PASSWORD=imposta_password_sicura_admin

# Password per l'utente demo (utente@test.local), creato al primo avvio
USER_PASSWORD=imposta_password_sicura_utente

# --- JWT ---
# Chiave segreta per la firma dei token JWT.
# Genera con:  openssl rand -hex 32
JWT_SECRET_KEY=genera_con_openssl_rand_hex_32

# --- Outgoing email (optional) ---
# Off while SMTP_HOST is unset. Any SMTP server works; see README.md, "Outgoing email".
# Check with: docker-compose exec api python -m scripts.send_test_mail you@example.org
#
# Local development with Mailpit (docker-compose --profile mail up -d mailpit,
# inbox on http://localhost:8025/):
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURITY=none
# MAIL_FROM=Meshbee <noreply@meshbee.local>
#
# A provider, e.g. Resend (ssl = implicit TLS on 465; starttls = 587):
# SMTP_HOST=smtp.resend.com
# SMTP_SECURITY=ssl
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key
# MAIL_FROM=Meshbee <noreply@mail.example.org>
#
# Optional extras: SMTP_PORT (default by SMTP_SECURITY), SMTP_TIMEOUT (seconds, 10).
# Where the app is reached, for links in emails:
# PUBLIC_BASE_URL=https://meshbee.example.org

# --- HTTPS (opzionale) ---
# Porta host su cui il proxy Caddy espone l'API in HTTPS.
# Serve solo se hai generato i certificati con `make certs`.
HTTPS_PORT=8443

# --- Produzione (solo sul server) ---
# Aggiunge docker-compose.prod.yml: HTTPS con Let's Encrypt, niente --reload,
# niente porte pubbliche per Postgres e l'API. Vedi README.md, "Production".
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# MESHBEE_DOMAIN=meshbee.example.org
# ACME_EMAIL=admin@example.org
